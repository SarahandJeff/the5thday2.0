<configs>

	<append xpath="/buffs/buff[@name='buffStatusCheck01']">
		<effect_group name="backpackCheck">
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$PA_Backpack" operation="set" value="0">
				<requirement name="WornItems" tags="backpack" operation="EQ" value="0"/>
			</triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$PA_Backpack" operation="set" value="1">
				<requirement name="WornItems" tags="backpack" operation="EQ" value="1"/>
			</triggered_effect>
		</effect_group>
	</append>

	<append xpath="/buffs">
		<buff name="PA_smallBackpack" name_key="PA_smallBackpack" description_key="backpackDesc" icon="ui_game_symbol_backpack" showonhud="false" remove_on_death="false">
			<stack_type value="ignore"/>
			<update_rate value="1"/>
			<duration value="0"/>
			<effect_group name="smallBackpack" tiered="false">
				<!-- <passive_effect name="CarryCapacity" operation="base_add" value="9"/> -->
				<passive_effect name="RunSpeed" operation="perc_subtract" value="0.03"/>
				<passive_effect name="WalkSpeed" operation="perc_subtract" value="0.03"/>
				<passive_effect name="CrouchSpeed" operation="perc_subtract" value="0.03"/>
				 
				<triggered_effect trigger="onSelfBuffUpdate" action="AttachPrefabToEntity" prefab="@:Entities/LootContainers/zpackBluePrefab.prefab" local_offset="0,-0.2,-0.15" local_rotation="0,180,0" local_scale="0.65,0.65,0.55" parent_transform="Spine3">
					<requirement name="CVarCompare" cvar="$PA_Backpack" operation="EQ" value="1"/>
				</triggered_effect>

				<triggered_effect trigger="onSelfBuffUpdate" action="RemovePrefabFromEntity" prefab="@:Entities/LootContainers/zpackBluePrefab.prefab" parent_transform="Spine">
					<requirement name="CVarCompare" cvar="$PA_Backpack" operation="EQ" value="0"/>
				</triggered_effect>

				<triggered_effect trigger="onSelfBuffRemove" action="RemovePrefabFromEntity" prefab="@:Entities/LootContainers/zpackBluePrefab.prefab" parent_transform="Spine3"/>
			</effect_group>

			<effect_group name="Encumbrance_vanilla" tiered="false">
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$encumbranceEffect" operation="subtract" value="0.006">
					<requirement name="ProgressionLevel" progression_name="perkPackMule" operation="GTE" value="3"/>
					<requirement name="CVarCompare" cvar="$PA_Backpack" operation="EQ" value="1"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="$encumbranceEffect" operation="add" value="0.006"/>
			</effect_group>
			<conditional>
				<if cond="mod_loaded('0-SCore') and mod_loaded('Encumbrance')">
					<effect_group name="Encumbrance_mod" tiered="false">
						<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$encumberedEffect" operation="subtract" value="0.006">
							<requirement name="ProgressionLevel" progression_name="perkPackMule" operation="GTE" value="3"/>
							<requirement name="CVarCompare" cvar="$PA_Backpack" operation="EQ" value="1"/>
						</triggered_effect>
						<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="$encumberedEffect" operation="add" value="0.006"/>
					</effect_group>
				</if>
			</conditional>
		</buff>

		<buff name="PA_mediumBackpack" name_key="PA_mediumBackpack" description_key="backpackDesc" icon="ui_game_symbol_backpack" showonhud="false" remove_on_death="false">
			<stack_type value="ignore"/>
			<update_rate value="1"/>
			<duration value="0"/>
			<effect_group name="mediumBackpack" tiered="false">
				<!-- <passive_effect name="CarryCapacity" operation="base_add" value="18"/> -->
				<passive_effect name="RunSpeed" operation="perc_subtract" value="0.04"/>
				<passive_effect name="WalkSpeed" operation="perc_subtract" value="0.04"/>
				<passive_effect name="CrouchSpeed" operation="perc_subtract" value="0.04"/>
				 
				<triggered_effect trigger="onSelfBuffUpdate" action="AttachPrefabToEntity" prefab="@:Entities/LootContainers/backpack03Prefab.prefab" local_offset="0,0,-0.1" local_rotation="120,-270,-90" local_scale="0.7,0.7,0.65" parent_transform="Spine3">
					<requirement name="CVarCompare" cvar="$PA_Backpack" operation="EQ" value="1"/>
				</triggered_effect>

				<triggered_effect trigger="onSelfBuffUpdate" action="RemovePrefabFromEntity" prefab="@:Entities/LootContainers/backpack03Prefab.prefab" parent_transform="Spine3">
					<requirement name="CVarCompare" cvar="$PA_Backpack" operation="EQ" value="0"/>
				</triggered_effect>

				<triggered_effect trigger="onSelfBuffRemove" action="RemovePrefabFromEntity" prefab="@:Entities/LootContainers/backpack03Prefab.prefab" parent_transform="Spine3"/>

			</effect_group>

			<effect_group name="Encumbrance_vanilla" tiered="false">
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$encumbranceEffect" operation="subtract" value="0.012">
					<requirement name="ProgressionLevel" progression_name="perkNightStalkerThiefAdrenaline" operation="GTE" value="3"/>
					<requirement name="CVarCompare" cvar="$PA_Backpack" operation="EQ" value="1"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="$encumbranceEffect" operation="add" value="0.012"/>
			</effect_group>
			<conditional>
				<if cond="mod_loaded('Encumbrance')">
					<effect_group name="Encumbrance_mod" tiered="false">
						<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$encumberedEffect" operation="subtract" value="0.012">
							<requirement name="ProgressionLevel" progression_name="perkPackMule" operation="GTE" value="3"/>
							<requirement name="CVarCompare" cvar="$PA_Backpack" operation="EQ" value="1"/>
						</triggered_effect>
						<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="$encumberedEffect" operation="add" value="0.012"/>
					</effect_group>
				</if>
			</conditional>
		</buff>

		<buff name="PA_largeBackpack" name_key="PA_largeBackpack" description_key="backpackDesc" icon="ui_game_symbol_backpack" showonhud="false" remove_on_death="false">
			<stack_type value="ignore"/>
			<update_rate value="1"/>
			<duration value="0"/>
			<effect_group name="largeBackpack" tiered="false">
				<!-- <passive_effect name="CarryCapacity" operation="base_add" value="27"/> -->
				<passive_effect name="RunSpeed" operation="perc_subtract" value="0.05"/>
				<passive_effect name="WalkSpeed" operation="perc_subtract" value="0.05"/>
				<passive_effect name="CrouchSpeed" operation="perc_subtract" value="0.05"/>
				 
				<triggered_effect trigger="onSelfBuffUpdate" action="AttachPrefabToEntity" prefab="@:Entities/LootContainers/weapon_bags_largePrefab.prefab" local_offset="0.05,-0.28,-0.32" local_rotation="0,0,0" local_scale="0.7,0.7,0.65" parent_transform="Spine3">
					<requirement name="CVarCompare" cvar="$PA_Backpack" operation="EQ" value="1"/>
				</triggered_effect>

				<triggered_effect trigger="onSelfBuffUpdate" action="RemovePrefabFromEntity" prefab="@:Entities/LootContainers/weapon_bags_largePrefab.prefab" parent_transform="Spine3">
					<requirement name="CVarCompare" cvar="$PA_Backpack" operation="EQ" value="0"/>
				</triggered_effect>

				<triggered_effect trigger="onSelfBuffRemove" action="RemovePrefabFromEntity" prefab="@:Entities/LootContainers/weapon_bags_largePrefab.prefab" parent_transform="Spine3"/>

			</effect_group>

			<effect_group name="Encumbrance_vanilla" tiered="false">
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$encumbranceEffect" operation="subtract" value="0.018">
					<requirement name="ProgressionLevel" progression_name="perkFiremansAlmanacComplete" operation="GTE" value="3"/>
					<requirement name="CVarCompare" cvar="$PA_Backpack" operation="EQ" value="1"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="$encumbranceEffect" operation="add" value="0.018"/>
			</effect_group>
			<conditional>
				<if cond="mod_loaded('Encumbrance')">
					<effect_group name="Encumbrance_mod" tiered="false">
						<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$encumberedEffect" operation="subtract" value="0.018">
							<requirement name="ProgressionLevel" progression_name="perkPackMule" operation="GTE" value="3"/>
							<requirement name="CVarCompare" cvar="$PA_Backpack" operation="EQ" value="1"/>
						</triggered_effect>
						<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="$encumberedEffect" operation="add" value="0.018"/>
					</effect_group>
				</if>
			</conditional>
		</buff>
	</append>

	<conditional>
		
		<if cond="mod_loaded('ScrollableBackpack_A88')">
			<set xpath="/buffs/buff[@name='PA_smallBackpack']/effect_group/passive_effect[@name='CarryCapacity']/@value">291</set>
			<set xpath="/buffs/buff[@name='PA_mediumBackpack']/effect_group/passive_effect[@name='CarryCapacity']/@value">291</set>
			<set xpath="/buffs/buff[@name='PA_largeBackpack']/effect_group/passive_effect[@name='CarryCapacity']/@value">291</set>
			<set xpath="/buffs/buff[@name='god']/effect_group/passive_effect[@name='CarryCapacity']/@value">291</set>
			<set xpath="/buffs/buff[@name='buffDrugSteroids']/effect_group/passive_effect[@name='CarryCapacity']/@value">291</set>
			<set xpath="/buffs/buff[@name='buffEncumberedInv']/effect_group/triggered_effect[@operation='multiply']/@value">0.025</set>
		</if>
		<if cond="mod_loaded('DewtasBackpackPages270Slots')">
			<set xpath="/buffs/buff[@name='PA_smallBackpack']/effect_group/passive_effect[@name='CarryCapacity']/@value">291</set>
			<set xpath="/buffs/buff[@name='PA_mediumBackpack']/effect_group/passive_effect[@name='CarryCapacity']/@value">291</set>
			<set xpath="/buffs/buff[@name='PA_largeBackpack']/effect_group/passive_effect[@name='CarryCapacity']/@value">291</set>
			<set xpath="/buffs/buff[@name='god']/effect_group/passive_effect[@name='CarryCapacity']/@value">291</set>
			<set xpath="/buffs/buff[@name='buffDrugSteroids']/effect_group/passive_effect[@name='CarryCapacity']/@value">291</set>
			<set xpath="/buffs/buff[@name='buffEncumberedInv']/effect_group/triggered_effect[@operation='multiply']/@value">0.033</set>
		</if>
	</conditional>

</configs>
