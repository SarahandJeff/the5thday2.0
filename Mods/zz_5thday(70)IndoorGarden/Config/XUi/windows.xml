<?xml version="1.0" encoding="UTF-8"?>
<Config>
    <append xpath="/windows">
        <window name="windowTools_IG" width="228" height="121" panel="Right" cursor_area="true">
            <panel style="header.panel">
                <sprite style="header.icon" sprite="ui_game_symbol_wrench" />
                <label style="header.name" text="TOOLS" text_key="XUI_windowTools_IndoorGarden" />
            </panel>
            <rect name="content" depth="0" pos="0,-46" height="75" disablefallthrough="true">
                <grid name="inventory" rows="1" cols="1" pos="3,-3" cell_width="75" cell_height="75" controller="WorkstationToolGrid" repeat_content="true" required_tools="carBattery" required_tools_only="true">
                    <item_stack controller="RequiredItemStack" name="0" />
                </grid>
            </rect>
        </window>
        <window name="windowOutput_IG" width="228" height="198" anchor="CenterTop" panel="Right" cursor_area="true" controller="WorkstationOutputWindow">
            <panel style="header.panel">
                <sprite style="header.icon" sprite="ui_game_symbol_loot_sack" />
                <label style="header.name.iconright" text="IN/OUT" text_key="IN/OUT" />
                <rect pivot="topleft" pos="0,0" controller="ContainerStandardControls" createuiwidget="true" visible="{buttons_visible}">
                    <button depth="3" name="btnMoveAll" sprite="ui_game_symbol_store_all_up" tooltip="{take_all_tooltip}" pos="203, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
                </rect>
            </panel>
            <rect name="content" depth="0" pos="0,-46" height="75" disablefallthrough="true">
                <sprite depth="2" name="backgroundMain" sprite="menu_empty3px" height="77" color="[black]" type="sliced" fillcenter="false" />
                <sprite depth="1" name="background" color="[black]" type="sliced" pos="75,0" width="75"/>
                <grid depth="10" name="inventory" rows="1" cols="1" pos="150,-3" cell_width="75" cell_height="75" controller="WorkstationOutputGrid" repeat_content="true">
                    <item_stack name="0" />
                </grid>
            </rect>
        </window>
        <window name="windowCraftingQueue_IG" width="397" height="78" panel="Right" cursor_area="true">
            <rect depth="20" pos="0,172" width="303" controller="CraftingQueue">
                <!-- <sprite name="background" color="[black]" type="sliced" pos="0,-10" /> -->
                <grid name="queue" rows="1" cols="1" pos="3,-13" cell_width="75" cell_height="75" repeat_content="true">
                    <recipe_stack name="0" />
                </grid>
            </rect>
        </window>
    </append>
</Config>