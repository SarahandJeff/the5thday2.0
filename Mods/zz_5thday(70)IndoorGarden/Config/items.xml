    <!-- Tools - Hydroponics Farm and Seed Station -->
    <append xpath="/items/item[@name='drugSteroids']">
        <effect_group tiered="false">
            <passive_effect name="CraftingIngredientCount" operation="base_subtract" value="2" tags="plantedAloe1" />
            <passive_effect name="CraftingIngredientCount" operation="base_subtract" value="2" tags="plantedBlueberry1" />
            <passive_effect name="CraftingIngredientCount" operation="base_subtract" value="2" tags="plantedChrysanthemum1" />
            <passive_effect name="CraftingIngredientCount" operation="base_subtract" value="2" tags="plantedCoffee1" />
            <passive_effect name="CraftingIngredientCount" operation="base_subtract" value="2" tags="plantedCorn1" />
            <passive_effect name="CraftingIngredientCount" operation="base_subtract" value="2" tags="plantedCotton1" />
            <passive_effect name="CraftingIngredientCount" operation="base_subtract" value="2" tags="plantedGoldenrod1" />
