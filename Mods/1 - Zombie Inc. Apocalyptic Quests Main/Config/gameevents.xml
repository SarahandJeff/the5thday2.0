<Config>

	<append xpath="/gameevents">
			<action_sequence name="ZombieINC_RemoveItems">	
	    
				<action class="AddPartyToGroup">
					<property name="phase" value="0" />
					<property name="group_name" value="party" />
				</action>	
				
				<action class="RemoveItems">
					<property name="phase" value="1" />
					<property name="group_name" value="party" />
					<property name="items_location" value="Toolbelt,Backpack"  />
					<property name="items_tags" value="ZombieINCRemove" />
				</action>
				
			</action_sequence>
	
			<action_sequence name="ZombieINC_Activate_Event_Anchor">
				<action class="AddBuff">
					<property name="buff_name" value="ZombieINC_TheCult_BellEffect_Buff" />
					<property name="phase" value="1"/>				
				</action>
				<action class="SpawnEntity">			
					<property name="entity_names" value="ZombieINC_RallyPointHuntPlaceHolder" />
				<!--	<property name="add_buffs" value="ZombieINC_EnemyDotBuff"/>-->
					<property name="spawn_count" value="1"  />
					<property name="max_distance" value="1" />
					<property name="min_distance" value="1" />
					<property name="air_spawn" value="true" />		
				</action>
			</action_sequence>
			
			<action_sequence name="ZombieINC_OneAnchorGenericPlacementByBuff">
					<property name="target_type" value="Entity" />
					<property name="allow_while_dead" value="true" />
					<!--<property name="single_instance" value="true" />-->
					<property name="refund_inactivity" value="false" />
					
					<action class="BlockReplace">
						<property name="min_offset" value="2,-10,1" />
						<property name="max_offset" value="2,10,1" />
						<property name="block_to" value="ZombieINC_Anchor_Generic_Block" />
						<property name="block_tags" value="air" />
						<property name="allow_terrain" value="true" />
						<property name="phase" value="1" />
					</action>
				</action_sequence>
				
				
				
				
