<Config>

	<append xpath="/blocks">
		<block name="ZombieINC_Anchor_Generic_Block">
			<property name="CreativeMode" value="Dev"/>
			<property name="Class" value="SpawnEntity"/>
			<property name="SpawnClass" value="ZombieINC_RallyPointHuntPlaceHolder"/>
			<property name="IndexName" value="Trader"/>
			<property name="CustomIcon" value="goreBlockAnimal"/>
			<property name="CustomIconTint" value="FF8000"/>
			<property name="DisplayType" value="blockHardened"/>
			<property name="Material" value="Mmetal_medium"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="@:Entities/Gore/animalRemainsGorePrefab.prefab"/>
			<property name="WaterFlow" value="permitted"/>
			<property name="Collide" value="sight"/>
			<property name="StabilitySupport" value="false"/>
			<drop event="Destroy" name="resourceScrapIron" count="0"/>
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1"/>
			<property name="SortOrder1" value="LD04"/>
			<property name="SortOrder2" value="0500"/>
			<property name="FilterTags" value="MC_helpers,SC_questblocks"/>
			<property name="Tags" value="TheCultRemover"/>
		</block>

		
