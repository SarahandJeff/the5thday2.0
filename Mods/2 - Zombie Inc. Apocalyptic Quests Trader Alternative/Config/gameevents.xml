	<action_sequence name="ZombieINC_ActiveRadioOnTrader_Event">
		<property name="allow_user_trigger" value="true" />
		<property name="action_type" value="Game" />
		<property name="target_type" value="Block"/>
		
		 <decision class="If">
			<requirement class="InPOI">
				<property name="name" value="trader_jen"/>
			</requirement>
			<action class="CallGameEvent">
				<property name="game_events" value="ZombieINC_ActiveRadioOnTraderSpawn_Event" />
				<property name="phase" value="1" />	
			</action>
		</decision>	
		 <decision class="If">		
			<requirement class="InPOI">
				<property name="name" value="trader_joel"/>
			</requirement>
			<action class="CallGameEvent">
				<property name="game_events" value="ZombieINC_ActiveRadioOnTraderSpawn_Event" />
				<property name="phase" value="1" />	
			</action>
		
		</decision>	
		 <decision class="If">		
			<requirement class="InPOI">
				<property name="name" value="trader_hugh"/>
			</requirement>
			<action class="CallGameEvent">
				<property name="game_events" value="ZombieINC_ActiveRadioOnTraderSpawn_Event" />
				<property name="phase" value="1" />	
			</action>
		
		</decision>	
		 <decision class="If">		
			<requirement class="InPOI">
				<property name="name" value="trader_bob"/>
			</requirement>
			<action class="CallGameEvent">
				<property name="game_events" value="ZombieINC_ActiveRadioOnTraderSpawn_Event" />
				<property name="phase" value="1" />	
			</action>
		
		</decision>	
		 <decision class="If">
			<requirement class="InPOI">
				<property name="name" value="trader_rekt"/>
			</requirement>
			<action class="CallGameEvent">
				<property name="game_events" value="ZombieINC_ActiveRadioOnTraderSpawn_Event" />
				<property name="phase" value="1" />	
			</action>
		
		
		</decision>	
	</action_sequence>
	
	<action_sequence name="ZombieINC_ActiveRadioOnTraderSpawn_Event">
		<property name="allow_user_trigger" value="true" />
		<property name="action_type" value="Game" />
		<property name="target_type" value="Entity"/>
		
		<action class="AddEntitiesToGroup">
			<property name="phase" value="1" />
			<property name="entity_tags" value="radio1,radiodecoy" />
			<property name="group_name" value="radioremove" />
			<property name="max_distance" value="45" />
		</action>
		<action class="BeltTooltip">
			<requirement class="GroupLiveCount">
				<property name="target_group" value="radioremove"/>
				<property name="operation" value="GTE"/> 
				<property name="count" value="1"/>
			</requirement>
			<property name="text_key" value="ZombieINC_DroneAlreadyHere_BeltTooltip" />
			<property name="phase" value="2" />
		</action>
		<action class="BeltTooltip">
			<requirement class="GroupLiveCount">
				<property name="target_group" value="radioremove"/>
				<property name="operation" value="Equals"/> 
				<property name="count" value="0"/>
			</requirement>
			<property name="text_key" value="ZombieINC_DroneCalled_BeltTooltip" />
			<property name="phase" value="2" />
		</action>	
		<action class="SpawnEntity">
			<requirement class="GroupLiveCount">
				<property name="target_group" value="radioremove"/>
				<property name="operation" value="Equals"/> 
				<property name="count" value="0"/>
			</requirement>
			<property name="entity_names" value="ZombieINC_NPC_Radio_1" />
			<property name="spawn_count" value="1"  />
			<property name="safe_spawn" value="true" />
			<property name="max_distance" value="20"  />
			<property name="min_distance" value="10"  />
			<property name="add_to_group" value="radio" />
			<property name="air_spawn" value="false" />
			<property name="phase" value="3" />
		</action>
		<action class="PlaySound">
			<property name="phase" value="3" />
			<property name="sound" value="drone_fly" />
			<property name="max_distance" value="25" />
		</action>
	</action_sequence>
	
	
	
