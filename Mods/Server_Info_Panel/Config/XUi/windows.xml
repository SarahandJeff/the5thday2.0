<snj>

<set xpath="//window[@name='ingameMenuSCore']/@anchor">LeftTop</set>
<set xpath="//window[@name='ingameMenuSCore']/@pos">20,-560</set>
	<append xpath="/windows">
		<window name="windowSNJ" depth="10" width="800" height="100" anchor="CenterCenter" cursor_area="true" >
			<panel name="core" depth="10" pos="-387,425" disableautobackground="true">
				<rect name="header">
					<label name="headerTitle" depth="10" pos="0,-22" justify="center" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" font_size="48" text_key="spd_headerTitle"/>
					<label name="headerMotto" depth="10" pos="0,-68" justify="center" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" font_size="28" text_key="spd_headerMotto"/>
					<sprite name="headerBorder" depth="3" sprite="menu_empty2px" color="[black]" type="sliced" fillcenter="false" />
					<sprite name="headerBackground" color="20,18,18" type="sliced" globalopacitymod="1.2" />
				</rect>
			
				<rect depth="50" name="links" width="36" height="36" pos="20,-18">
					<rect name="link1" pos="1,0" pivot="center">
						<texture depth="50" pivot="center" height="30" width="30" texture="@https://www.jeffthepcguy.com/5thday/discord.png"/>
						<rect controller="NewsWindow" sources="https://www.jeffthepcguy.com/5thday/discord.xml">
							<button depth="49" name="btnLink" pos="-18,16" height="36" width="36" hoverscale="1" defaultcolor="0,0,0,1" disabledcolor="0,0,0,1" hovercolor="0,0,0,1" type="sliced" enabled="{has_link}" gamepad_selectable="{has_news}" tooltip_key="link1"/>
						</rect>
					</rect>
					<rect name="link2" pos="39,0" pivot="center">
						<texture depth="50" pivot="center" height="30" width="30" texture="@https://www.jeffthepcguy.com/5thday/twitch.png"/>
						<rect controller="NewsWindow" sources="https://www.jeffthepcguy.com/5thday/twitch.xml">
							<button depth="49" name="btnLink" pos="-18,16" height="36" width="36" hoverscale="1" defaultcolor="0,0,0,1" disabledcolor="0,0,0,1" hovercolor="0,0,0,1" type="sliced" enabled="{has_link}" gamepad_selectable="{has_news}" tooltip_key="link2"/>
						</rect>
					</rect>
					<rect name="link3" pos="76,0" pivot="center">
						<texture depth="50" pivot="center" height="30" width="30" texture="@https://www.jeffthepcguy.com/5thday/youtube.png"/>
						<rect controller="NewsWindow" sources="https://www.jeffthepcguy.com/5thday/youtube.xml">
							<button depth="49" name="btnLink" pos="-18,16" height="36" width="36" hoverscale="1" defaultcolor="0,0,0,1" disabledcolor="0,0,0,1" hovercolor="0,0,0,1" type="sliced" enabled="{has_link}" gamepad_selectable="{has_news}" tooltip_key="link3"/>
						</rect>
					</rect>
					
				</rect>



		<rect name="tabs" controller="TabSelector" pos="0,-100" height="800">
			<sprite depth="10" name="border" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" globalopacity="true" globalopacitymod="0.9" />
			<sprite depth="0" pos="0,-120" width="798" height="680" name="backgroundMain" sprite="menu_empty3px" color="[darkestGrey]" type="sliced" fillcenter="true" globalopacity="false"/>
			<rect name="tabsHeader" height="39" depth="0">
				<sprite depth="0" name="backgroundMainTabs" sprite="menu_empty3px" color="0,0,0,150" type="sliced" fillcenter="true" globalopacity="true" />

				<grid name="tabButtons" pos="3,-2" depth="2" rows="2" cols="5" cell_width="160" cell_height="55" repeat_content="true" arrangement="horizontal">
					<rect controller="TabSelectorButton">
						<simplebutton name="tabButton" depth="2" pos="-1,0" width="158" height="53" font_size="34" bordercolor="[transparent]" defaultcolor="[darkGrey]" selectedsprite="menu_empty" selectedcolor="[mediumGrey]" foregroundlayer="false" caption="{tab_name_localized}" />
					</rect>
				</grid>
			</rect>

			<rect name="tabsContents" depth="2" pos="5,-150" height="680" >
				

				<rect controller="TabSelectorTab" tab_key="tab1"><label depth="7" name="TextContent"  font_size="24" color="[white]" justify="left" pivot="topleft" text="tab1Desc" text_key="tab1Desc"/></rect>
				<rect controller="TabSelectorTab" tab_key="tab2"><label depth="7" name="TextContent"  font_size="24" color="[white]" justify="left" pivot="topleft" text="tab2Desc" text_key="tab2Desc"/></rect>
				<rect controller="TabSelectorTab" tab_key="tab3"><label depth="7" name="TextContent"  font_size="24" color="[white]" justify="left" pivot="topleft" text="tab3Desc" text_key="tab3Desc"/></rect>
				<rect controller="TabSelectorTab" tab_key="tab4"><label depth="7" name="TextContent"  font_size="24" color="[white]" justify="left" pivot="topleft" text="tab4Desc" text_key="tab4Desc"/></rect>
				<rect controller="TabSelectorTab" tab_key="tab5"><label depth="7" name="TextContent"  font_size="24" color="[white]" justify="left" pivot="topleft" text="tab5Desc" text_key="tab5Desc"/></rect>

				<rect controller="TabSelectorTab" tab_key="tab6"><label depth="7" name="TextContent"  font_size="24" color="[white]" justify="left" pivot="topleft" text="tab6Desc" text_key="tab6Desc"/></rect>
				<rect controller="TabSelectorTab" tab_key="tab7"><label depth="7" name="TextContent"  font_size="24" color="[white]" justify="left" pivot="topleft" text="tab7Desc" text_key="tab7Desc"/></rect>
				<rect controller="TabSelectorTab" tab_key="tab8"><label depth="7" name="TextContent"  font_size="24" color="[white]" justify="left" pivot="topleft" text="tab8Desc" text_key="tab8Desc"/></rect>
				<rect controller="TabSelectorTab" tab_key="tab9"><label depth="7" name="TextContent"  font_size="24" color="[white]" justify="left" pivot="topleft" text="tab9Desc" text_key="tab9Desc"/></rect>
				<rect controller="TabSelectorTab" tab_key="tab10"><label depth="7" name="TextContent"  font_size="24" color="[white]" justify="left" pivot="topleft" text="tab10Desc" text_key="tab10Desc"/></rect>
			</rect>
		</rect>

			</panel>
		</window>
	</append>
</snj>