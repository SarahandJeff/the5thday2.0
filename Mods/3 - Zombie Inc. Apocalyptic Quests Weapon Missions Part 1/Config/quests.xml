				<property name="nav_object" value="return_to_trader" />
			</objective>	
			
			<objective type="InteractWithNPC" phase="3">
				<property name="nav_object" value="return_to_trader" />						
			</objective>
    
			<reward type="Exp" value="8000"/>
			<reward type="Item" id="ZombieINC_gunHandgunT1Pistol" value="1"/>			
