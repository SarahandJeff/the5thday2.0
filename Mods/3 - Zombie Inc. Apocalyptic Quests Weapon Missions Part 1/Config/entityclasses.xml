 <!--TurretZombies-->

<entity_class name="ZombieINC_zombieSkateboarder_Turret1" extends="zombieSkateboarder">
	<property name="UserSpawnType" value="Menu"/>
	<property name="Tags" value="entity,zombie,walker,zombieTurret,miniboss"/>
	<property name="ExperienceGain" value="400"/><!-- XP strong feral -->
	<property name="LootDropProb" value="1"/> <!-- Feral -->
	<property name="LootDropEntityClass" value="ZombieINC_M60_LootDrop"/>
	<property name="LookAtAngle" value="0"/>
	<property name="WalkType" value="22"/>
	<property name="RootMotion" value="true"/>
	<property name="HandItem" value="ZombieINC_meleeHandMiniBossTurret"/>
	<property name="RightHandJointName" value="Muzzle"/>
	<property name="MoveSpeedAggro" value="0.5, 1.2"/> 
	
	<property name="AITask" value="
		BreakBlock|
		DestroyArea|
		Territorial|
		RangedAttackTarget itemType=1;cooldown=5;duration=10;minRange=1;maxRange=20|
		ApproachAndAttackTarget class=EntityPlayer,0|
		ApproachSpot|
		Look|
		Wander|
		"/>
	
	<effect_group name="Base Effects">
		<passive_effect name="HealthMax" operation="base_set" value="550"/>
		<triggered_effect trigger="onSelfFirstSpawn" action="ModifyCVar" target="self" cvar="EntityBoss" operation="set" value="1"/>
		<triggered_effect trigger="onSelfFirstSpawn" action="AddBuff" target="self" buff="ZombieINC_Turret1_AttachPrefabBuff"/>
		<!--<triggered_effect trigger="onSelfFirstSpawn" action="AddBuff" target="self" buff="ZombieINC_TurretZombies_AnimationBuff"/>-->
	</effect_group>
</entity_class>

