<Config>
<append xpath="/entity_classes">

<entity_class name="ZombieINC_Terrorist_AK47" extends="zombieSkateboarder">
	<property name="UserSpawnType" value="Menu"/>
	<property name="Tags" value="entity,zombie,walker,MiniBossAK47,boss"/>
	<property name="ExperienceGain" value="400"/><!-- XP strong feral -->
	<property name="LootDropProb" value="1"/> <!-- Feral -->
	<property name="LootDropEntityClass" value="ZombieINC_AK_LootDrop"/>
	<property name="NavObject" value="zombie" />
	
	<effect_group name="Base Effects">
		<passive_effect name="HealthMax" operation="base_set" value="550"/>
		<triggered_effect trigger="onSelfFirstSpawn" action="ModifyCVar" target="self" cvar="EntityBoss" operation="set" value="1"/>
		<triggered_effect trigger="onSelfFirstSpawn" action="AddBuff" target="self" buff="ZombieINC_BanditsAK47_AttachPrefabBuff"/>
	</effect_group>
</entity_class>

