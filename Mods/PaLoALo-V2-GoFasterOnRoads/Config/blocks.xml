<configs>

<!-- WALK/RUN FASTER ON ASPHALT & CONCRETE -->
	<append xpath="//block[@name='terrGravel']">
		<property name="BuffsWhenWalkedOn" value="buffAsphaltConcreteSpeed"/>
	</append>
	<append xpath="//block[@name='terrAsphalt']">
		<property name="BuffsWhenWalkedOn" value="buffAsphaltConcreteSpeed"/>
	</append>
	<append xpath="//block[@name='terrConcrete']">
		<property name="BuffsWhenWalkedOn" value="buffAsphaltConcreteSpeed"/>
	</append>
<!-- Adding this smooths out the speed bump effect of the road markings (they're painted concrete blocks) -->
	<append xpath="//block[@name='concreteShapes']">
		﻿<property name="BuffsWhenWalkedOn" value="buffAsphaltConcreteSpeed"/>
	</append>

</configs>