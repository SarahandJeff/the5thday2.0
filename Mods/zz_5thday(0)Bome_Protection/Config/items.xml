			<triggered_effect trigger="onSelfEquipStart" action="ModifyCVar" cvar="$BurntHazardTimer" operation="set" value="0">
				<requirement name="CVarCompare" cvar="$BiomeBadgeLevel" operation="LT" value="1"/></triggered_effect>
			<triggered_effect trigger="onSelfEquipStart" action="ModifyCVar" cvar="$DesertHazardTimer" operation="set" value="180">
				<requirement name="CVarCompare" cvar="$BiomeBadgeLevel" operation="LT" value="1"/></triggered_effect>
			<triggered_effect trigger="onSelfEquipStart" action="ModifyCVar" cvar="$SnowHazardTimer" operation="set" value="120">
				<requirement name="CVarCompare" cvar="$BiomeBadgeLevel" operation="LT" value="1"/></triggered_effect>
			<triggered_effect trigger="onSelfEquipStart" action="ModifyCVar" cvar="$WastelandHazardTimer" operation="set" value="60">
