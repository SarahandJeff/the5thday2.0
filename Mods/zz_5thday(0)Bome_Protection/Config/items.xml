			<triggered_effect trigger="onSelfEquipStop" action="ModifyCVar" cvar="$BurntHazardTimerMax" operation="set" value="180"/>
			<triggered_effect trigger="onSelfEquipStop" action="ModifyCVar" cvar="$DesertHazardTimerMax" operation="set" value="120"/>
			<triggered_effect trigger="onSelfEquipStop" action="ModifyCVar" cvar="$SnowHazardTimerMax" operation="set" value="60"/>
			<triggered_effect trigger="onSelfEquipStop" action="ModifyCVar" cvar="$WastelandHazardTimerMax" operation="set" value="30"/>
		
			<!-- BiomeBadgeLevel CVar is referenced in code. Do not change. -->
			<triggered_effect trigger="onSelfEquipStart" action="ModifyCVar" cvar="$BiomeBadgeLevel" operation="set" value="1"/>
