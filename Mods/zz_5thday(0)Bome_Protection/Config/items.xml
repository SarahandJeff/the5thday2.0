		<passive_effect name="ModSlots" operation="base_set" value="0"/>
	</effect_group>

	<effect_group>
		<requirement name="CVarCompare" cvar="_equipReload" operation="LT" value="1"/>

			<triggered_effect trigger="onSelfEquipStart" action="ModifyCVar" cvar="$BurntHazardTimerMax" operation="set" value="-1"/>
			<triggered_effect trigger="onSelfEquipStart" action="ModifyCVar" cvar="$DesertHazardTimerMax" operation="set" value="180"/>
			<triggered_effect trigger="onSelfEquipStart" action="ModifyCVar" cvar="$SnowHazardTimerMax" operation="set" value="120"/>
