<?xml version="1.0" encoding="UTF-8"?>

<Schiffu_ThermalNV>

    <!-- Eigene Händler-Gruppe für die Thermal-Helm-Mod -->
    <append xpath="//traders/trader_item_groups">
        <trader_item_group name="SchiffuThermalNVMods" count="1">
            <!-- Item ist deine Helm-Mod -->
            <item name="modArmorThermalVision" />
        </trader_item_group>
    </append>

    <!-- Jetzt diese Gruppe bei den gleichen Händlern einhängen,
         die FNZ auch für die SuperGuns nutzt (Trader-IDs 1,2,6,7,8) -->

    <append xpath="//trader_info[@id='1']">
        <trader_items count="all">
            <item group="SchiffuThermalNVMods" count="1" />
        </trader_items>
    </append>

    <append xpath="//trader_info[@id='2']">
        <trader_items count="all">
            <item group="SchiffuThermalNVMods" count="1" />
        </trader_items>
    </append>

    <append xpath="//trader_info[@id='6']">
        <trader_items count="all">
            <item group="SchiffuThermalNVMods" count="1" />
        </trader_items>
    </append>

    <append xpath="//trader_info[@id='7']">
        <trader_items count="all">
            <item group="SchiffuThermalNVMods" count="1" />
        </trader_items>
    </append>

    <append xpath="//trader_info[@id='8']">
        <trader_items count="all">
            <item group="SchiffuThermalNVMods" count="1" />
        </trader_items>
    </append>

</Schiffu_ThermalNV>
