<configs>
    <append xpath="/buffs">
        <buff name="buffThermalNV">
            <display_name>Thermal Night Vision</display_name>
            <description>Aktiviert thermische Wahrnehmung mit Auren.</description>

            <!-- läuft dauerhaft, solange wir ihn nicht per Trigger entfernen -->
            <duration_value>-1</duration_value>
            <stack_type>replace</stack_type>

            <!-- Icon ist erstmal egal, wir nehmen ein vorhandenes -->
            <icon>ui_game_symbol_radar</icon>

            <!-- Keine Statuseffekte nötig, Buff ist nur ein „Flag“ für später -->
        </buff>
    </append>
</configs>
