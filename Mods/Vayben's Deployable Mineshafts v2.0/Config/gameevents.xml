<configs>
    <append xpath="/gameevents">
        <action_sequence name="VaybensDeployableMineshaft">
            <property name="action_type" value="Game" />
            <property name="target_type" value="Block" />
            <property name="allow_while_dead" value="true" />

            <!-- Play 3 second countdown -->
            <loop class="For">
                <property name="loop_count" value="3" />
                <property name="phase" value="1" />

                <action class="Delay">
                    <property name="time" value="1" />
                </action>

                <action class="PlaySound">
                    <property name="sound" value="twitch_countdown_tick" />
                </action>
            </loop>

            <!-- Clear the dirt and stone for supports-->
            <loop class="For">
                <property name="loop_count" value="1" />
                <property name="phase" value="2" />

                <action class="BlockReplace">
                    <property name="min_offset" value="2,-15,2" />
                    <property name="max_offset" value="2,-2,2" />
                    <property name="block_to" value="air" />
                    <property name="safe_allowed" value="false" />
                    <property name="allow_terrain" value="true" />
                </action>

                <action class="BlockReplace">
                    <property name="min_offset" value="-2,-15,-2" />
                    <property name="max_offset" value="-2,-2,-2" />
                    <property name="block_to" value="air" />
                    <property name="safe_allowed" value="false" />
                    <property name="allow_terrain" value="true" />
                </action>

                <action class="BlockReplace">
                    <property name="min_offset" value="-2,-15,2" />
                    <property name="max_offset" value="-2,-2,2" />
                    <property name="block_to" value="air" />
                    <property name="safe_allowed" value="false" />
                    <property name="allow_terrain" value="true" />
                </action>

                <action class="BlockReplace">
                    <property name="min_offset" value="2,-15,-2" />
                    <property name="max_offset" value="2,-2,-2" />
                    <property name="block_to" value="air" />
                    <property name="safe_allowed" value="false" />
                    <property name="allow_terrain" value="true" />
                </action>

                <action class="BlockReplace">
                    <property name="min_offset" value="0,-15,0" />
                    <property name="max_offset" value="0,-2,0" />
                    <property name="block_to" value="air" />
                    <property name="safe_allowed" value="false" />
                    <property name="allow_terrain" value="true" />
                </action>
            </loop>

            <!-- Place virtical supports -->
            <loop class="For">
                <property name="loop_count" value="14" />
                <property name="phase" value="3" />

                <action class="BlockReplace">
                    <property name="min_offset" value="2,-15,2" />
                    <property name="max_offset" value="2,-2,2" />
                    <property name="block_to" value="woodMaster" />
                    <property name="safe_allowed" value="false" />
                    <property name="empty_only" value="true" />
                </action>

                <action class="BlockReplace">
                    <property name="min_offset" value="-2,-15,-2" />
                    <property name="max_offset" value="-2,-2,-2" />
                    <property name="block_to" value="woodMaster" />
                    <property name="safe_allowed" value="false" />
                    <property name="empty_only" value="true" />
                </action>

                <action class="BlockReplace">
                    <property name="min_offset" value="-2,-15,2" />
                    <property name="max_offset" value="-2,-2,2" />
                    <property name="block_to" value="woodMaster" />
                    <property name="safe_allowed" value="false" />
                    <property name="empty_only" value="true" />
                </action>

                <action class="BlockReplace">
                    <property name="min_offset" value="2,-15,-2" />
                    <property name="max_offset" value="2,-2,-2" />
                    <property name="block_to" value="woodMaster" />
                    <property name="safe_allowed" value="false" />
                    <property name="empty_only" value="true" />
                </action>

                <action class="BlockReplace">
                    <property name="min_offset" value="0,-15,0" />
                    <property name="max_offset" value="0,-2,0" />
                    <property name="block_to" value="ladderWood" />
                    <property name="safe_allowed" value="false" />
                    <property name="empty_only" value="true" />
                </action>
            </loop>

            <action class="PlaySound">
                <property name="phase" value="4" />
                <property name="sound" value="place_block_wood" />
            </action>

            <!-- Clear the dirt and stone for above ground structure-->
            <loop class="For">
                <property name="loop_count" value="1" />
                <property name="phase" value="5" />
                <action class="BlockReplace">
                    <property name="min_offset" value="-2,-1,-2" />
                    <property name="max_offset" value="2,2,2" />
                    <property name="block_to" value="air" />
                    <property name="safe_allowed" value="false" />
                    <property name="allow_terrain" value="true" />
                </action>
            </loop>

            <!-- Place above ground structure -->
            <loop class="For">
                <property name="loop_count" value="4" />
                <property name="phase" value="6" />
                <action class="BlockReplace">
                    <property name="min_offset" value="-2,-1,-2" />
                    <property name="max_offset" value="2,2,2" />
                    <property name="block_to" value="woodMaster" />
                    <property name="safe_allowed" value="false" />
                    <property name="empty_only" value="true" />
                </action>
            </loop>

            <action class="PlaySound">
                <property name="sound" value="place_block_wood" />
                <property name="phase" value="7" />
            </action>

            <!-- Clear the inside of above ground structure-->
            <loop class="For">
                <property name="loop_count" value="1" />
                <property name="phase" value="8" />
                <action class="BlockReplace">
                    <property name="min_offset" value="-1,0,-1" />
                    <property name="max_offset" value="1,2,1" />
                    <property name="block_to" value="air" />
                    <property name="safe_allowed" value="false" />
                    <property name="allow_terrain" value="true" />
                </action>
            </loop>

            <!-- Clear all the dirt and stone in mine-->
            <action class="PlaySound">
                <property name="sound" value="place_block_wood" />
                <property name="phase" value="9" />
            </action>

            <action class="BlockReplace">
                <property name="phase" value="10" />
                <property name="min_offset" value="-2,-15,-2" />
                <property name="max_offset" value="2,2,2" />
                <property name="block_to" value="air" />
                <property name="exclude_tags" value="wood,ore,deepore" />
                <property name="allow_terrain" value="true" />
                <property name="safe_allowed" value="false" />
            </action>
            <action class="PlaySound">
                <property name="phase" value="11" />
                <property name="sound" value="shovel_stone_swinglight" />
            </action>

            <!-- Clear for the hatch ladder-->
            <action class="BlockReplace">
                <property name="phase" value="12" />
                <property name="min_offset" value="0,-1,0" />
                <property name="max_offset" value="0,-1,0" />
                <property name="block_to" value="air" />
                <property name="safe_allowed" value="false" />
                <property name="empty_only" value="false" />
            </action>
            <!-- Place the hatch ladder-->
            <action class="BlockReplace">
                <property name="phase" value="13" />
                <property name="min_offset" value="0,-1,0" />
                <property name="max_offset" value="0,-1,0" />
                <property name="block_to" value="ladderWood" />
                <property name="safe_allowed" value="false" />
                <property name="empty_only" value="true" />
            </action>

            <!-- Clear for the hatch-->
            <action class="BlockReplace">
                <property name="phase" value="14" />
                <property name="min_offset" value="0,0,0" />
                <property name="max_offset" value="0,0,0" />
                <property name="block_to" value="air" />
                <property name="safe_allowed" value="false" />
                <property name="empty_only" value="false" />
            </action>
            <!-- Place the hatch-->
            <action class="BlockReplace">
                <property name="phase" value="15" />
                <property name="min_offset" value="0,0,0" />
                <property name="max_offset" value="0,0,0" />
                <property name="block_to" value="woodHatch" />
                <property name="safe_allowed" value="false" />
                <property name="empty_only" value="true" />
            </action>

        </action_sequence>
    </append>
</configs>
