	<quest id="ZINCVehicleDelivery1"> 
		    <property name="name_key" value="ZombieINC_challenge_tier1_VehicleDelivery_name"/>
		    <property name="subtitle_key" value="ZombieINC_challenge_tier1_VehicleDelivery_subtitle"/>
		    <property name="description_key" value="ZombieINC_challenge_tier1_VehicleDelivery_description"/>
		    <property name="icon" value="ui_game_symbol_quest"/>
		    <property name="repeatable" value="false"/>
		    <property name="category_key" value="quest"/>
		    <property name="difficulty" value="Ridiculous"/>
		    <property name="difficulty_tier" value="1"/>
		    <property name="offer_key" value="ZombieINC_challenge_tier1_VehicleDelivery_offer"/>
		    <property name="statement_key" value="ZombieINC_challenge_tier1_VehicleDelivery_statement"/>
		    <property name="response_key" value="ZombieINC_challenge_tier1_VehicleDelivery_response"/>
		    <property name="login_rally_reset" value="true"/>		
			<property name="reward_choices_count" value="5" />
			<property name="extra_tags" value="ZINCVH,ZINCVHT1"  />
			<property name="shareable" value="true"/>
			<property name="quest_hints" value="ZombieINC_VH_RideTheVehicle" />
			
		    <property name="completiontype" value="AutoComplete"/>
		    <property name="completion_key" value="ZombieINC_challenge_tier1_VehicleDelivery_completion"/>
					
			<objective type="RandomGotoNPC" phase="1">
				<property name="completion_distance" value="20"/>
				<property name="distance" value="200-300"/>
				<property name="nav_object" value="quest" />
			</objective>

			<objective type="RallyPoint">
				<property name="start_mode" value="Create"/>
				<property name="phase" value="2"/>
				<property name="nav_object" value="rally" />
				<property name="activate_event" value="ZombieINC_Activate_Event_Buried_Vehicle_T1"/>
				<property name="rally_marker_type" value="questRallyMarkerBuriedSupplies"/>
			</objective>
			
			<action type="GameEvent" id="ZombieINC_VehicleDelivery_RemoveAllBuffsWhenFail_T1" phase="3"/>
			<action type="GameEvent" id="ZombieINC_VehicleDelivery_New_Message0" phase="3"/>
			
			<objective type="StayWithin">
				<property name="phase" value="3"/>
				<property name="radius" value="20"/>
			</objective>

			<objective type="TreasureChest">
				<property name="phase" value="3" />
				<property name="block" value="cntBuriedFoodStashChest"/>
				<property name="default_radius" value="2"/>
				<property name="container_type" value="Supplies"/>
				<property name="nav_object" value="treasure" />
				<property name="direct_nav_object" value="treasure_direct" />
				<property name="blocks_per_reduction" value="1" />
				<property name="radius_reduction_sound" value="ui_radius_shrink" />
				<property name="use_nearby" value="true" />
			</objective>
		
			<objective type="StayWithin">
				<property name="phase" value="4"/>
				<property name="radius" value="20"/>
			</objective>
			
			<objective type="FetchFromTreasure">	        
				<property name="phase" value="4" />
				<property name="block" value="cntBuriedFoodStashChest"/>
				<property name="quest_item_ID" value="1"/>
				<property name="item_count" value="1"/>
			</objective>
					
			<action type="GameEvent" id="ZombieINC_VehicleDelivery_New_Message1" phase="5"/>
			<action type="GameEvent" id="ZombieINC_VehicleDelivery_AddMoveDetector_T1" phase="5"/>
			<action type="GameEvent" id="ZombieINC_VehicleDelivery_PlayerFailQuest_T1" phase="5"/>
				
			<objective type="ReturnToNPC" phase="5">
				<property name="nav_object" value="return_to_trader" />
			</objective>
			
			<action type="GameEvent" id="ZombieINC_VehicleDelivery_FinishedDelivery" phase="6"/>
			
			
			<objective type="Time">
				<property name="phase" value="6"/>
				<property name="time" value="1"/>
			</objective>
            
			<reward type="Quest" id="ZINCVehicleDelivery1Reward"/>
	</quest>
