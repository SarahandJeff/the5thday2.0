<Config>

	<append xpath="/nav_object_classes">
		<nav_object_class name="ZombieINC_supply">
		
			<map_settings>
				<property name="sprite_name" value="ui_game_symbol_twitch_drop"/>
				<property name="min_distance" value="0"/>
				<property name="max_distance" value="-1"/>
				<property name="color" value="10,200,10,255"/>
				<property name="has_pulse" value="true"/>
			</map_settings>

			<compass_settings>
				<property name="sprite_name" value="ui_game_symbol_twitch_drop"/>
				<property name="min_distance" value="0"/>
				<property name="max_distance" value="500"/>
				<property name="max_scale_distance" value="1024"/>
				<property name="color" value="10,200,10,255"/>
				<property name="has_pulse" value="true"/>
				<property name="icon_clamped" value="false" />
			</compass_settings>

			<onscreen_settings>
				<property name="sprite_name" value="ui_game_symbol_twitch_drop"/>
				<property name="min_distance" value="0"/>
				<property name="max_distance" value="500"/>
				<property name="color" value="10,200,10,255"/>
				<property name="has_pulse" value="true"/>
				<property name="text_type" value="SpawnName"/>
			</onscreen_settings>
		</nav_object_class>

		<nav_object_class name="ZombieINC_supply_other">
		
		
			<map_settings>
				<property name="sprite_name" value="ui_game_symbol_twitch_drop"/>
				<property name="min_distance" value="0"/>
				<property name="max_distance" value="-1"/>
				<property name="color" value="255,255,255,255"/>
			</map_settings>

			<compass_settings>
				<property name="sprite_name" value="ui_game_symbol_twitch_drop"/>
				<property name="min_distance" value="0"/>
				<property name="max_distance" value="500"/>
				<property name="max_scale_distance" value="1024"/>
				<property name="color" value="255,255,255,255"/>
				<property name="icon_clamped" value="false" />
			</compass_settings>

			<onscreen_settings>
				<property name="sprite_name" value="ui_game_symbol_twitch_drop"/>
				<property name="min_distance" value="0"/>
				<property name="max_distance" value="500"/>
				<property name="color" value="255,255,255,255"/>
				<property name="text_type" value="SpawnName"/>
			</onscreen_settings>
		</nav_object_class>
		

	
		<nav_object_class name="ZombieINC_Defense_fetch_container">

			<compass_settings>
				<property name="sprite_name" value="ui_game_symbol_fetch_loot"/>
				<property name="up_sprite_name" value="ui_game_symbol_fetch_loot_up"/>
				<property name="down_sprite_name" value="ui_game_symbol_fetch_loot_down"/>
				<property name="min_distance" value="0"/>
				<property name="max_scale_distance" value="32"/>
				<property name="color" value="255,180,0,255"/>
				<property name="has_pulse" value="true"/>
				<property name="icon_clamped" value="true" />
			</compass_settings>

			<onscreen_settings>
				<property name="sprite_name" value="ui_game_symbol_fetch_loot"/>
				<property name="min_distance" value="0"/>
				<property name="max_distance" value="35"/>
				<property name="color" value="255,180,0,255"/>
				<property name="has_pulse" value="true"/>
				<property name="text_type" value="Distance"/>
				<property name="show_offscreen" value="true" />
			</onscreen_settings>
		</nav_object_class>
		
		<nav_object_class name="ZombieINC_trader">
		
			<map_settings>
			  <property name="sprite_name" value="ui_game_symbol_map_trader"/>
			  <property name="min_distance" value="0"/>
			  <property name="max_distance" value="50"/>
			  <property name="color" value="255,255,0,255"/>
			  <property name="has_pulse" value="true"/>
			</map_settings>

			<onscreen_settings>
			  <property name="sprite_name" value="ui_game_symbol_map_trader"/>
			  <property name="min_distance" value="3"/>
			  <property name="max_distance" value="70"/>
			  <property name="color" value="255,255,0,255"/>
			  <property name="has_pulse" value="true"/>
			  <property name="text_type" value="Distance"/>
			  <property name="offset" value="0,2.1,0" />
			</onscreen_settings>
		</nav_object_class>
		
		
		<nav_object_class name="ZombieINC_EnemyDot" extends="zombie">
					
			<map_settings>
				<property name="sprite_name" value="ui_game_symbol_enemy_dot"/>
				<property name="color" value="255,0,0,255"/>
				<property name="has_pulse" value="true"/>
			</map_settings>

			<compass_settings>
				<property name="sprite_name" value="ui_game_symbol_enemy_dot"/>
				<property name="color" value="255,0,0,255"/>
				<property name="has_pulse" value="true"/>
				<property name="icon_clamped" value="true" />
			</compass_settings>
		</nav_object_class>
			
	</append>

</Config>