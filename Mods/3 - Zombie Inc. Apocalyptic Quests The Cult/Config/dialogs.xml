		<statement id="resetallprogress2" text="ZombieINC_Dialog_Ritual_resetallprogress2">
			<response_entry id="resetallprogressyes" />
			<response_entry id="resetallprogressno" />
		</statement>
		<response id="resetallprogress" text="ZombieINC_Dialog_Ritual_resetallprogress" nextstatementid="resetallprogress2">
			<requirement type="CheckCVar" id="ZINCTC2COMPLETED" value="1" requirementtype="Hide" />
