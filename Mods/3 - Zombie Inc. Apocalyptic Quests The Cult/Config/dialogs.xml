<Config>

<append xpath="/dialogs">

	<dialog id="ritual1" startstatementid="start">
	
		<statement id="start" text="ZombieINC_Dialog_Ritual_Start">
			<response_entry id="jobsnone" />
			<response_entry id="jobshave1" />		
			<response_entry id="StartRitual" />
			<response_entry id="UpgradeRitual" />
			<!--<response_entry id="RitualStarted" />-->
			<response_entry id="jobshavenotallowed" />
			<response_entry id="pick" />
			<response_entry id="resetallprogress" />
			<response_entry id="done" />
		</statement>
		
		<response id="nevermind" text="ZombieINC_Dialog_Ritual_NeverMind" nextstatementid="start" />

		<statement id="currentjobs1" text="ZombieINC_Dialog_Ritual_QuestList" nextstatementid="start" >	
			<quest_entry listindex="0" tier="1" />
			<quest_entry listindex="1" tier="1" />
			<quest_entry listindex="2" tier="1" />
			<quest_entry listindex="3" tier="1" />
			<quest_entry listindex="4" tier="1" />
			<response_entry id="nevermind" />
		</statement>
		<response id="jobshave1" text="ZombieINC_Dialog_Ritual_Quest" nextstatementid="currentjobs1" >
			<requirement type="QuestStatus" value="NotStarted" requirementtype="Hide" />
			<requirement type="CheckCVar" id="ZINCTC2COMPLETED" value="0" requirementtype="Hide" />
			<requirement type="CheckCVar" id="ZINCRitualStarted" value="1" requirementtype="Hide" />
		</response>
		
		<response id="StartRitual" text="ZombieINC_Dialog_Ritual_StartRitual" >
			<requirement type="CheckCVar" id="ZINCRitualStarted" value="0" requirementtype="Hide" />
			<!--<requirement type="CheckCVar" id="ZINCRitualLevel" value="0" requirementtype="Hide" />-->
			<requirement type="CheckCVar" id="ZINCTC3COMPLETED" value="0" requirementtype="Hide" />
			<requirement type="CheckCVar" id="ZINCRitualLevel2" value="0" requirementtype="Hide" />
			<requirement type="CheckCVar" id="ZINCRitualLevel3" value="0" requirementtype="Hide" />
			<requirement type="CheckCVar" id="ZINCRitualLevel4" value="0" requirementtype="Hide" />
			<requirement type="CheckCVar" id="ZINCRitualLevel5" value="0" requirementtype="Hide" />
			<requirement type="CheckCVar" id="ZINCRitualLevel6" value="0" requirementtype="Hide" />
			<action type="AddBuff" id="ZombieINC_RitualStart1_Buff" />
		</response>
		<response id="UpgradeRitual" text="ZombieINC_Dialog_Ritual_StartUpgradeRitual" >
			<requirement type="CheckCVar" id="ZINCTC3COMPLETED" value="1" requirementtype="Hide" />
			<!--<requirement type="CheckCVar" id="ZINCRitualStarted" value="1" requirementtype="Hide" />-->
			<action type="AddBuff" id="ZombieINC_RitualUpgrade1_Buff" />
		</response>
		<response id="RitualStarted" text="ZombieINC_Dialog_RitualStarted" nextstatementid="start" >
			<!--<requirement type="Buff" id="ZombieINC_RitualStart_Buff" requirementtype="Hide" />-->
			<requirement type="CheckCVar" id="ZINCRitualStarted" value="1" requirementtype="Hide" />
			<!--<action type="AddQuest" id="zincpriest" />-->
			<!--<action type="AddQuest" quest="zincpriest" listindex="0"/>-->
		</response>	
		<statement id="nojobs" text="ZombieINC_Dialog_Ritual_QuestInProgressNext" nextstatementid="start" />
		<response id="jobsnone" text="ZombieINC_Dialog_Ritual_QuestInProgress" nextstatementid="nojobs" >
			<requirement type="QuestStatus" value="InProgress" requirementtype="Hide" />
		</response>
		<statement id="jobsnotallowed" text="ZombieINC_Dialog_Ritual_DisableQuestingNext" nextstatementid="start" />
		<response id="jobshavenotallowed" text="ZombieINC_Dialog_Ritual_DisableQuesting" nextstatementid="jobsnotallowed" >
			<requirement type="CheckCVar" id="DisableQuesting" value="1" requirementtype="Hide" />
		</response>		
		<response id="pick" text="ZombieINC_Dialog_Ritual_Pickme">
			<action type="AddBuff" id="ZombieINC_TheCult_RitualToPlayer1_Dialog_Buff" />
		</response>
		
		<response id="resetallprogressyes" text="ZombieINC_Dialog_Ritual_resetallprogressyes">
			<action type="AddBuff" id="ZombieINC_TheCult_ResetAllProgress_Dialog_Buff" />
		</response>
