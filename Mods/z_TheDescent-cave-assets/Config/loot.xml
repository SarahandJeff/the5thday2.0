<configs>

    <insertAfter xpath="/lootcontainers/lootgroup[@name='empty']">

        <lootgroup name="groupArmyMedals" count="1">
            <item name="armyMedal01" />
            <item name="armyMedal02" />
            <item name="armyMedal03" />
            <item name="armyMedal04" />
            <item name="armyMedal05" />
        </lootgroup>

        <lootgroup name="groupOldMedals" count="1">
            <item name="oldMedal01" />
            <item name="oldMedal02" />
            <item name="oldMedal03" />
            <item name="oldMedal04" />
            <item name="oldMedal05" />
        </lootgroup>

        <lootgroup name="groupCoins" count="1">
            <item name="coin01" />
            <item name="coin02" />
            <item name="coin03" />
            <item name="coin04" />
            <item name="coin05" />
        </lootgroup>

        <lootgroup name="groupJewels" count="1">
            <item name="jewel01" />
            <item name="jewel02" />
            <item name="jewel03" />
            <item name="jewel04" />
            <item name="jewel05" />
        </lootgroup>

        <lootgroup name="groupPirateTreasure" count="1">
            <item name="pirateTreasure01" />
            <item name="pirateTreasure02" />
            <item name="pirateTreasure03" />
            <item name="pirateTreasure04" />
            <item name="pirateTreasure05" />
        </lootgroup>

    </insertAfter>

    <append xpath="/lootcontainers/lootgroup[@name='caveGroupWoodenChest']">
        <item name="roadFlare" loot_prob_template="low" />
        <item count="1" group="groupOldMedals" loot_prob_template="medLow" force_prob="true" />
        <item count="1" group="groupPirateTreasure" loot_prob_template="medLow" force_prob="true" />
        <item count="1" group="groupCoins" loot_prob_template="medLow" force_prob="true" />
    </append>

    <append xpath="/lootcontainers/lootgroup[@name='caveGroupMilitaryFootlocker']">
        <item name="roadFlare" loot_prob_template="medLow" force_prob="true" />
        <item group="groupArmyMedals" loot_prob_template="medLow" force_prob="true" />
    </append>

    <append xpath="/lootcontainers/lootgroup[@name='caveGroupOldWestChest']">
        <item count="1,3" name="roadFlare" loot_prob_template="low" />
    </append>

    <append xpath="/lootcontainers/lootcontainer[@name='caveCntBackpack']">
        <item name="roadFlare" loot_prob_template="low" />
    </append>

    <append xpath="/lootcontainers/lootgroup[@name='caveGroupCampingTents01']">
        <item name="roadFlare" loot_prob_template="med" />
    </append>

</configs>