			<AudioClip ClipName="#@modfolder:Resources/Sounds.unity3d?vaultfrontdoorclose"/>
			<LocalCrouchVolumeScale value="0.8"/>
			<CrouchNoiseScale value="0.8"/>
			<NoiseScale value="1"/>
			<MaxVoices value="10"/>
			<MaxRepeatRate value="0.01"/>
