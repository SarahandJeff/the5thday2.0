			<CrouchNoiseScale value="0.8"/>
			<NoiseScale value="1"/>
			<MaxVoices value="1"/>
			<MaxRepeatRate value="0.01"/>
		</SoundDataNode>
		
		<SoundDataNode name="vaultfrontdoorclose"> <AudioSource name="@:Sounds/Prefabs/AudioSource_UseAction.prefab"/>
