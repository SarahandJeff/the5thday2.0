<audio>

	<append xpath="/Sounds">
	
		<SoundDataNode name="overseersdoor"> <AudioSource name="@:Sounds/Prefabs/AudioSource_UseAction.prefab"/>
			<Noise ID="3" noise="30" volume="15" time="2" muffled_when_crouched="0.8"/>
			<AudioClip ClipName="#@modfolder:Resources/Sounds.unity3d?overseersdoor"/>
			<LocalCrouchVolumeScale value="0.8"/>
			<CrouchNoiseScale value="0.8"/>
			<NoiseScale value="1"/>
			<MaxVoices value="5"/>
			<MaxRepeatRate value="0.01"/>
