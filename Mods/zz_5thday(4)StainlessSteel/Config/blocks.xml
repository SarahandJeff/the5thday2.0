<configs>
    <!-- add back stainless steel blocks and polish -->
    <append xpath="/blocks">
        <block name="cntBeerCooler">
            <property name="Extends" value="cntMiniBeverageCooler" />
        </block>
        <block name="stainlessSteelMaster">
            <property name="CreativeMode" value="None" />
            <property name="Group" value="Building,advBuilding" />
            <property name="DescriptionKey" value="steelBlockGroupDesc" />
            <property name="Material" value="MstainlessSteel" />
            <property name="DisplayType" value="blockHardened" />
            <property name="PassThroughDamage" value="false" />
            <property name="TintColor" value="f9e6ff" />
            <property name="Texture" value="191" />
            <property class="RepairItems">
                <property name="SSPolish" value="5" />
            </property>
            <property name="CustomUpgradeSound" value="place_block_metal" />
            <drop event="Harvest" name="resourceScrapIron" count="15" tag="allHarvest" />
            <drop event="Destroy" count="0" />
            <drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1" />
            <property name="DescriptionKey" value="steelBlockGroupDesc" />
            <property name="DowngradeBlock" value="steelMaster" />
            <property name="FilterTags" value="MC_building" />
            <property name="SortOrder1" value="40p0" />
            <property name="SortOrder2" value="0002" />
        </block>
        <block name="stainlessSteelShapes" shapes="All">
            <property name="DescriptionKey" value="steelBlockGroupDesc" />
            <property name="Material" value="Mstainlesssteel_shapes" />
            <property name="TintColor" value="f9e6ff" />
            <property name="Shape" value="New" />
            <property name="DisplayType" value="blockHardened" />
            <property name="PassThroughDamage" value="false" />
            <property name="Texture" value="191" />
            <property name="UiBackgroundTexture" value="191" />
            <property class="RepairItems">
                <property name="SSPolish" value="5" />
            </property>
            <property name="CustomUpgradeSound" value="place_block_metal" />
            <drop event="Harvest" name="resourceScrapIron" count="15" tag="allHarvest" />
            <drop event="Destroy" count="0" />
            <drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1" />
            <property name="EconomicValue" value="160" />
            <property name="Group" value="Building,advBuilding" />
            <property name="ItemWeight" value="150" />
            <property name="DowngradeBlock" value="steelShapes" />
            <property name="FilterTags" value="MC_Shapes" />
            <property name="SortOrder1" value="0011" />
        </block>
    </append>
    <append xpath="/blocks/block[@name='steelMaster']">
        <property class="UpgradeBlock">
            <property name="ToBlock" value="stainlessSteelMaster" />
            <property name="Item" value="SSPolish" />
            <property name="ItemCount" value="2" />
            <property name="UpgradeHitCount" value="2" />
        </property>
    </append>
    <append xpath="/blocks/block[@name='steelShapes']">
        <property class="UpgradeBlock">
            <property name="ToBlock" value="stainlessSteelShapes" />
            <property name="Item" value="SSPolish" />
            <property name="ItemCount" value="2" />
            <property name="UpgradeHitCount" value="2" />
        </property>
    </append>
    <append xpath="/blocks">
        <block name="cntStainlessSteelWritableCrate">
            <property name="CreativeMode" value="Player" />
            <property name="TintColor" value="b000e6" />
            <property name="Class" value="CompositeTileEntity" />
            <property class="CompositeFeatures">
                <property class="TEFeatureStorage">
                    <property name="LootList" value="playerStainlessSteelWritableStorage" />
                </property>
                <property class="TEFeatureLockable" />
                <property class="TEFeatureSignable">
                    <property name="FontSize" value="90" />
                    <property name="LineCount" value="3" />
                    <property name="LineWidth" value="0.55" />
                </property>
            </property>
            <property name="DescriptionKey" value="cntStainlessSteelWritableCrateDesc" />
            <property name="Material" value="Msteel" />
            <property name="Shape" value="ModelEntity" />
            <!-- <property name="Model" value="@:Entities/LootContainers/steelWritableCratePrefab.prefab" /> -->
            <property name="Model" value="#@modfolder:Assets/SSCrate.unity3d?StainlessSteelWritableCrate" />
            <property name="ModelOffset" value="0,0,0" />
            <property name="WaterFlow" value="permitted" />
            <property name="Path" value="solid" />
            <property name="Place" value="TowardsPlacerInverted" />
            <property name="AllowedRotations" value="Basic90" />
            <property name="FuelValue" value="0" />
            <property name="EconomicValue" value="6" />
            <property name="MaxDamage" value="10000" />
            <property name="SoundPickup" value="cratesteel_grab" />
            <property name="SoundPlace" value="cratesteel_place" />
            <property class="RepairItems">
                <property name="SSPolish" value="2" />
            </property>
            <drop event="Destroy" name="resourceForgedSteel" count="1,3" />
            <drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1" />
            <property name="DowngradeBlock" value="cntStainlessSteelWritableCrateInsecure" />
            <property name="SortOrder1" value="B106" />
            <property name="SortOrder2" value="0004" />
            <property name="Group" value="Building,advBuilding" />
            <property name="Tags" value="timecharge" />
            <property name="FilterTags" value="MC_playerBlocks,SC_decor" />
        </block>
        <block name="cntStainlessSteelWritableCrateInsecure">
            <property name="CreativeMode" value="None" />
            <property name="Class" value="CompositeTileEntity" />
            <property class="CompositeFeatures">
                <property class="TEFeatureStorage">
                    <property name="LootList" value="playerStainlessSteelWritableStorage" />
                </property>
                <property class="TEFeatureSignable">
                    <property name="FontSize" value="90" />
                    <property name="LineCount" value="3" />
                    <property name="LineWidth" value="0.55" />
                </property>
            </property>
            <property name="CustomIcon" value="cntStainlessSteelWritableCrate" />
            <property name="Material" value="Mmetal" />
            <property name="Shape" value="ModelEntity" />
            <property name="Model" value="@:Entities/LootContainers/ironWritableCratePrefab.prefab" />
            <property name="WaterFlow" value="permitted" />
            <property name="AllowedRotations" value="Basic90" />
            <property name="Path" value="solid" />
            <property name="MaxDamage" value="7500" />
            <property class="RepairItems">
                <property name="SSPolish" value="2" />
            </property>
            <drop event="Destroy" name="resourceForgedSteel" count="1,2" />
            <drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1" />
            <property name="SortOrder1" value="B106" />
            <property name="SortOrder2" value="0003" />
        </block>
    </append>
    <append xpath="//block[@name='cntSteelWritableCrate']">
        <property class="UpgradeBlock">
            <property name="ToBlock" value="cntStainlessSteelWritableCrate" />
            <property name="Item" value="SSPolish" />
            <property name="ItemCount" value="4" />
            <property name="UpgradeHitCount" value="4" />
        </property>
    </append>
       <append xpath="/blocks/block[@name='stainlessSteelShapes']">
        <property class="UpgradeBlock">
            <property name="ToBlock" value="TitaniumShapes" />
            <property name="Item" value="TitaniumPolish" />
            <property name="ItemCount" value="5" />
            <property name="UpgradeHitCount" value="4" />
        </property>
    </append>
</configs>