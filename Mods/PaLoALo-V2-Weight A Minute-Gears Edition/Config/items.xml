<configs>

<!-- reduce coin weight for encumbrance; 10kg for a stack of 20k -->
	<append xpath="/items/item[@name='casinoCoin']">
		<property name="ItemWeight" value="0.001"/>
	</append>

	<append xpath="/items/item[@name='oldCash']">
		<property name="ItemWeight" value="0.0001"/>
	</append>

</configs>