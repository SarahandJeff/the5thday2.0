<configs>

<conditional>
	<if cond="mod_loaded('0-SCore_sphereii') == 'true' and mod_loaded('Quartz') == 'true'">
		<set xpath="/windows/window[@name='windowBackpack']/panel[@name='header']/label[@name='windowName']/@pos">42,-9</set>
		<set xpath="/windows/window[@name='windowBackpack']/panel[@name='header']/label[@name='windowName']/@width">200</set>
		<set xpath="/windows/window[@name='windowBackpack']/panel[@name='header']/label[@name='windowName']/@font_size">36</set>
		<setattribute xpath="/windows/window[@name='windowBackpack']/panel[@name='header']/label[@name='windowName']" name="justify">center</setattribute>

	<!-- backpack inventory weight shows different colors for increasing encumberance -->
	<!-- percentage based result -->
		<setattribute xpath="/windows/window[@name='windowBackpack']/panel[@name='header']/label[@name='windowName']" 
		name="color">{# (cvar('encumbranceCVar') > (cvar('MaxEncumbranceCVar') * 0.9)) ? '200,0,0,255' : ((cvar('encumbranceCVar') > (cvar('MaxEncumbranceCVar') * 0.7)) ? '120,120,0,255' : '255,255,255,255') }</setattribute>
		<set xpath="/windows/window[@name='windowBackpack']/panel[@name='header']/label[@name='windowName']/@text_key">{# round(cvar('encumbranceCVar'), 2) } / {# round(cvar('MaxEncumbranceCVar'), 2) } kg ({# round(((cvar('encumbranceCVar') / cvar('MaxEncumbranceCVar')) * 100), 2) } %)</set>

	<!-- backpack encumberance monitor -->
		<setattribute xpath="/windows/window[@name='windowBackpack']/panel[@name='header']/label[@name='windowName']" name="controller">Quartz.CVarTimer, Quartz</setattribute>
		<setattribute xpath="/windows/window[@name='windowBackpack']/panel[@name='header']/label[@name='windowName']" name="timer">0.5</setattribute>
	</if>
</conditional>

</configs>