<configs>

<!-- Encumbrance -->
<conditional>
	<if cond="mod_loaded('Gears') and mod_loaded('0-SCore_sphereii') and mod_loaded('SCoreChanges')">
		<append xpath="/entity_classes/entity_class[@name='playerMale']">
			<effect_group name="encumberment_start">
				<triggered_effect trigger="onSelfEnteredGame" action="ModifyCVar" cvar=".MaxEncumbrance" operation="set" value="modsetting('SCoreChanges', 'global', 'SCoreSettings1.EncVal.MaxEncumbrance')"/>
				<triggered_effect trigger="onSelfRespawn" action="ModifyCVar" cvar=".MaxEncumbrance" operation="set" value="modsetting('SCoreChanges', 'global', 'SCoreSettings1.EncVal.MaxEncumbrance')"/>
			</effect_group>
		</append>
	</if>
</conditional>
<conditional>
	<if cond="mod_loaded('0-SCore_sphereii')">
		<append xpath="/entity_classes/entity_class[@name='playerMale']">
			<effect_group name="encumberment_start">
				<triggered_effect trigger="onSelfEnteredGame" action="ModifyCVar" cvar=".MaxEncumbrance" operation="set" value="70"/>
				<triggered_effect trigger="onSelfRespawn" action="ModifyCVar" cvar=".MaxEncumbrance" operation="set" value="70"/>
			</effect_group>
		</append>
	</if>
</conditional>

</configs>