<?xml version="1.0" encoding="UTF-8"?>
<configs>
    <!--
        NPC Core removes "EntityBandit" from animal targeting.
        Since the 1.0 BM templates use a class that descends from "EntityBandit" we need to add it back.
        But only append it if it's not already there, so this won't cause issues if NPC Core fixes that bug.
    -->
    <conditional>
        <!-- This is also done in the Psychos pack, so don't even try if it is installed. -->
        <if cond="mod_loaded('1-khzmusik_NPC_Psychos') == false">
            <append xpath="//entity_class[starts-with(@name, 'animal')]//property[@value='SetNearestEntityAsTarget' and contains(@data,'EntityPlayer') and not(contains(@data,'EntityBandit'))]/@data">,EntityBandit,0,0</append>
            <append xpath="//entity_class[starts-with(@name, 'animal')]//property[@value='ApproachAndAttackTarget' and contains(@data,'EntityPlayer') and not(contains(@data,'EntityBandit'))]/@data">,EntityBandit,15</append>
        </if>
    </conditional>

    <!--
        Append only the entity_class XML tags for each entity, including the templates they extend.
        The remaining XML tags will be appended to each entity_class, specific to each character.
        This keeps the XML tags consistent within characters, makes it easier to debug characters,
        and reduces the chance of copy-and-paste errors.
    -->
