    <!--
        Rogues: Basic NPCs
        These NPCs don't have dialog options and can't be hired.
        However, they can be spawned into hordes (wandering or blood moon).

        NOTE: This XPath adds tags and properties that are only used for "advanced" characters.
        Their presence doesn't do any harm, but they make it much easier to turn the characters
        into their "advanced" versions later, using XPath - see below.
    -->
    <!-- This character should only spawn into the pine forest or snow biomes. -->
    <append xpath="//entity_class[starts-with(@name,'RogueFemaleAgedKhz')]">
